{
  "description": "Codex-native lifecycle hooks for Drasus Engine.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/session_start.py\"",
            "statusMessage": "Loading Drasus Engine workflow guidance",
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
