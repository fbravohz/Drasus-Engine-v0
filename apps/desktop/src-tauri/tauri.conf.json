{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drasus Engine",
  "version": "0.1.0",
  "identifier": "com.drasus.engine.desktop.dev",
  "build": {
    "beforeDevCommand": "cargo build --manifest-path ../../Cargo.toml --bin drasus && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build --manifest-path ../../Cargo.toml --release --bin drasus && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Drasus Engine",
        "decorations": false,
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
